<%- include('../includes/head.ejs') %>
<link rel = "stylesheet" href = "/css/authForm.css" >

</head>


<body>
    <%- include('../includes/navigation.ejs') %>

    <main class="auth-display">
        
        <div class="userForm">
            <div class="accountTitle">
                <h2>Login</h2>
                <% if(validationErrorMessage) { %>
                    <div class = "errorMessage">
                        <%= validationErrorMessage %>
                    </div>
                <% } %>  
            </div>
            <form id = "fill-formy" class="userFillForm" action="/login" method="POST" novalidate>
                <div class="input-holder">
                    <fieldset>
                        <label for="email" class="label-hidden">Email</label>
                        <input type="email" name="email" id = "email" placeholder="Email" value="<%= oldInput.email %>">
                    </fieldset>
                    <fieldset>
                        <label for="password" class="label-hidden">Password</label>
                        <input type="password" name="password" id = 'password' placeholder="Password" value="<%= oldInput.password %>">
                    </fieldset>
                </div>
                <p>
                    <input type="submit" value="Login" class="submitFormButton">
                </p>
                <p class="submessage">
                    New to the Blog?
                    <a class ="submessage-link" href="/signup">Sign up now.</a>
                </p>
            </form>
        </div>
    </main>


<!-- </body>
</html> -->
<%- include('../includes/end.ejs') %>