<%- include('../includes/head.ejs') %>
<link rel = "stylesheet" href = "/css/authForm.css" >

</head>


<body>
    <%- include('../includes/navigation.ejs') %>

    <main class="auth-display">
       
        <div class="userForm">
            
            <div class="accountTitle">
                <h2>Create Account</h2>
                <% if(validationErrorMessage) { %>
                    <div class = "errorMessage">
                        <%= validationErrorMessage %>
                    </div>
                <% } %>  
            </div>
            <form class = "userFillForm" action="/signup" method = "POST" novalidate>
                <div class="input-holder">
                    <fieldset>
                        <label for="FirstName" class="label-hidden">First Name</label>
                        <input type="text" name="firstName" id="FirstName" placeholder="First Name" value="<%= oldInput.firstName %>">
                    </fieldset>
                    <fieldset>
                        <label for="LastName" class="label-hidden">Last Name</label>
                        <input type="text" name="lastName" id="LastName" placeholder="Last Name" value="<%= oldInput.lastName %>">
                    </fieldset>
                    <fieldset>
                        <label for="email" class="label-hidden">Email</label>
                        <input type="email" name="email" id = "email" placeholder="Email" value="<%= oldInput.email %>">
                    </fieldset>
                    <fieldset>
                        <label for="password" class="label-hidden">Password</label>
                        <input type="password" name="password" id = 'password' placeholder="Password" value="<%= oldInput.password %>">
                    </fieldset>
                </div>
                <p>
                    <input type="submit" value="Sign UP" class="submitFormButton">
                </p>
                <p class="submessage">
                    Already have an account?
                    <a class ="submessage-link" href="/login">Sign in now.</a>
                </p>
            </form>
        </div>
    </main>


<!-- </body>
</html> -->
<%- include('../includes/end.ejs') %>