<%- include('../includes/head.ejs') %>

</head>


<body>

    <%- include('../includes/navigation.ejs') %>

    <main>

        <div class = "createPostContent">
            <form class = "product-form"  enctype="multipart/form-data" action = "/createPost" method = "POST">
                <label>Title</label>
                <input type = "text" id = "postTitle" name = "title" placeholder="enter title here">
                <label>Overview</label>
                <textarea style = "white-space: pre-wrap;" id = "content" rows = "10" cols = "100" name = "overview" placeholder="overview"></textarea>
                <label>Content</label> 
                <textarea style = "white-space: pre-wrap;" id = "content" rows = "10" cols = "100" name = "content" placeholder="enter content here"></textarea>
                <label for="image">Upload Image</label>
                <input type="text" name="image" id="image" placeholder="Enter image link here">
                <button type = "submit">Submit Post</button>
            </form>
        </div>

    </main>




</body>
</html>